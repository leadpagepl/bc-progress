# Zapytanie o wycenę (app/api/wycena). Skopiuj do .env.local i uzupełnij.
# Ten plik jest w repozytorium — nigdy nie wpisuj tu prawdziwych wartości.

# Resend: e-mail z zapytaniem. Bez tych trzech zmiennych API zwraca
# SERVICE_UNAVAILABLE, a formularz mówi wprost, że nic nie wysłano.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Tylko lokalnie: 1 = udana wysyłka bez wywołania Resend (do testów UI).
# Ignorowane w buildzie produkcyjnym (next build / Vercel).
LEAD_DRY_RUN=

# Faza 2 — jeszcze nieużywane:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# GOOGLE_SHEETS_...=   (sposób uwierzytelnienia do ustalenia w fazie 2)
# durable rate limiting: zmienne zależne od wybranego magazynu
