# Zapytanie o wycenę (app/api/wycena). Skopiuj do .env.local i uzupełnij.
# Ten plik jest w repozytorium — nigdy nie wpisuj tu prawdziwych wartości.

# Google Apps Script: zapis leada w Sheets i załączników na Drive.
# Aktywny kanał. Bez tych dwóch zmiennych API zwraca SERVICE_UNAVAILABLE,
# a formularz mówi wprost, że nic nie wysłano. Tylko po stronie serwera —
# nigdy z prefiksem NEXT_PUBLIC_.
GOOGLE_LEADS_WEBHOOK_URL=
GOOGLE_LEADS_WEBHOOK_SECRET=

# Resend: dodatkowe powiadomienie e-mail po udanym zapisie w Google.
# Opcjonalne — błąd lub brak konfiguracji nie blokuje formularza.
# CONTACT_TO to jedyny odbiorca powiadomień.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Cloudflare Turnstile: wymagany. Bez sekretu albo tokenu API odrzuca
# zgłoszenie (VERIFICATION_FAILED) i nie wywołuje Google ani Resend.
# Klucz witryny trafia do przeglądarki (NEXT_PUBLIC_), sekret — nigdy.
# Lokalnie można użyć publicznych kluczy testowych Cloudflare:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
#   (zawsze przepuszcza), secret 2x0000000000000000000000000000000AA (zawsze odrzuca).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tylko lokalnie: 1 = udana wysyłka bez wywołania integracji (do testów UI).
# Ignorowane w buildzie produkcyjnym (next build / Vercel).
LEAD_DRY_RUN=

# Opcjonalne: publiczny adres strony dla canonical, Open Graph, sitemap i
# JSON-LD (lib/site.ts). Bez niej Vercel sam podaje domenę produkcyjną
# projektu. Ustaw tylko, gdy adresem głównym ma być inny niż najkrótsza
# domena, np. https://www.przyklad.pl — zawsze z https://, bez ścieżki.
SITE_URL=

# Limit zapytań: reguła Vercel WAF dla POST /api/wycena (konfiguracja w
# panelu Vercel, poza repozytorium) + lokalny licznik w rate-limit.ts.
