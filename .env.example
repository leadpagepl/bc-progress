# Zapytanie o wycenę (app/api/wycena). Skopiuj do .env.local i uzupełnij.
# Ten plik jest w repozytorium — nigdy nie wpisuj tu prawdziwych wartości.

# Google Apps Script: zapis leada w Sheets i załączników na Drive.
# Aktywny kanał. Bez tych dwóch zmiennych API zwraca SERVICE_UNAVAILABLE,
# a formularz mówi wprost, że nic nie wysłano. Tylko po stronie serwera —
# nigdy z prefiksem NEXT_PUBLIC_.
GOOGLE_LEADS_WEBHOOK_URL=
GOOGLE_LEADS_WEBHOOK_SECRET=

# Resend: dodatkowe powiadomienie e-mail po udanym zapisie w Google.
# Opcjonalne — błąd lub brak konfiguracji nie blokuje formularza.
# CONTACT_TO to jedyny odbiorca powiadomień.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Tylko lokalnie: 1 = udana wysyłka bez wywołania integracji (do testów UI).
# Ignorowane w buildzie produkcyjnym (next build / Vercel).
LEAD_DRY_RUN=

# Następna faza — jeszcze nieużywane:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# durable rate limiting: zmienne zależne od wybranego magazynu
